# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Local npm registry config (points to corporate UHC JFrog registry — not for CI)
.npmrc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets stay local, env identifiers are committed
.env.local
.env.local.example
!.env.stage
!.env.production

# Terraform secrets (credentials, API keys)
*.secrets.tfvars
terraform/tfplan

# Deploy logs
deploy*.log

# vercel
.vercel

# typescript
*.tsbuildinfo

# P2 synced data (generated by scripts/sync_p2_data.py)
/public/data/dashboards/
/public/data/dims/
/public/data/models/
/public/data/rag/
/public/data/employers/
/public/data/_manifest.json
next-env.d.ts

# Temporary scripts
tmp_script_*.py

# AI agent session logs (may contain secrets in history files)
.wingman/
.docs/

# Private strategy docs (local only — not for public repo)
TRAFFIC_GROWTH_PLAN.md

# Python cache
__pycache__/
*.pyc
