# Compass AWS Deployment — Example Configuration
# Copy this file:  cp terraform.tfvars.example terraform.tfvars
# Then edit the values below.

# AWS region
aws_region = "us-east-1"

# Environment (dev, staging, prod)
environment = "staging"

# S3 bucket name — MUST BE GLOBALLY UNIQUE across all AWS accounts
# Tip: include your account ID for uniqueness
s3_bucket_name = "compass-immigration-insights-ACCOUNT_ID"

# Custom domain (optional — leave empty for CloudFront default domain)
domain_name = ""

# Route 53 zone ID (optional — only needed with custom domain)
route53_zone_id = ""

# ACM certificate (set true only when domain_name is set)
create_certificate = false
